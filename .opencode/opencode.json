{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "npm install*": "deny",
      "rtk npm install*": "deny",
      "npm ci*": "deny",
      "rtk npm ci*": "deny",
      "npm exec*": "deny",
      "rtk npm exec*": "deny",
      "npx *": "deny",
      "rtk npx *": "deny",
      "nx run*": "deny",
      "rtk nx run*": "deny",
      "nx affected*": "deny",
      "rtk nx affected*": "deny",
      "mix deps.get*": "deny",
      "rtk mix deps.get*": "deny",
      "mix compile*": "deny",
      "rtk mix compile*": "deny",
      "mix test*": "deny",
      "rtk mix test*": "deny",
      "mix phx.server*": "deny",
      "rtk mix phx.server*": "deny",
      "dotnet build*": "deny",
      "rtk dotnet build*": "deny",
      "dotnet test*": "deny",
      "rtk dotnet test*": "deny",
      "*./hippo run*": "allow"
    }
  }
}
