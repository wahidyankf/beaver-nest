{
  "name": "beaver-nest",
  "version": "1.0.0",
  "private": true,
  "description": "Private Phoenix LiveView family app for Tailscale-based home hosting.",
  "main": "index.js",
  "directories": {
    "doc": "plans"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "prepare": "husky",
    "start": "npm exec nx run bnest-app:serve",
    "test": "npm exec -- nx run -p bnest-app -t test:unit",
    "test:e2e": "npm exec -- nx run -p bnest-e2e -t test:e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wahidyankf/beaver-nest.git"
  },
  "keywords": [],
  "author": "wahidyankf",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/wahidyankf/beaver-nest/issues"
  },
  "homepage": "https://github.com/wahidyankf/beaver-nest#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4.3.0",
    "@types/node": "^26.2.0",
    "@types/phoenix": "^1.6.7",
    "daisyui": "^5.5.20",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "nx": "23.1.1",
    "oxlint": "^1.79.0",
    "playwright-bdd": "^9.2.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2"
  },
  "nx": {}
}
