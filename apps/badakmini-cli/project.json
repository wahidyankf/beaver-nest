{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "badakmini-cli",
  "projectType": "application",
  "root": "apps/badakmini-cli",
  "targets": {
    "build": {
      "command": "dotnet build Badakmini.Cli.fsproj --configuration Release",
      "options": {
        "cwd": "apps/badakmini-cli"
      },
      "outputs": ["{projectRoot}/bin", "{projectRoot}/obj"]
    },
    "typecheck": {
      "command": "badakmini_typecheck_dir=$(mktemp -d /tmp/badakmini-typecheck.XXXXXX) && trap 'rm -rf -- \"$badakmini_typecheck_dir\"' EXIT HUP INT TERM && dotnet build tests/unit/Badakmini.Cli.UnitTests.fsproj --configuration Release --artifacts-path \"$badakmini_typecheck_dir/unit\" && dotnet build tests/integration/Badakmini.Cli.IntegrationTests.fsproj --configuration Release --artifacts-path \"$badakmini_typecheck_dir/integration\"",
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/badakmini/cli/behaviours/**/*"
      ],
      "options": {
        "cwd": "apps/badakmini-cli"
      }
    },
    "test:unit": {
      "command": "dotnet test tests/unit/Badakmini.Cli.UnitTests.fsproj --configuration Release --filter 'FullyQualifiedName!~FeatureComplianceTests&FullyQualifiedName!~UnitPolicyTests'",
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/badakmini/cli/behaviours/**/*"
      ],
      "options": {
        "cwd": "apps/badakmini-cli"
      },
      "outputs": [
        "{projectRoot}/tests/unit/bin",
        "{projectRoot}/tests/unit/obj"
      ]
    },
    "test:integration": {
      "command": "dotnet test tests/integration/Badakmini.Cli.IntegrationTests.fsproj --configuration Release",
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/badakmini/cli/behaviours/**/*"
      ],
      "options": {
        "cwd": "apps/badakmini-cli"
      },
      "outputs": [
        "{projectRoot}/tests/integration/bin",
        "{projectRoot}/tests/integration/obj"
      ]
    },
    "test:coverage:unit": {
      "command": "dotnet test tests/unit/Badakmini.Cli.UnitTests.fsproj --configuration Debug --filter 'FullyQualifiedName!~FeatureComplianceTests&FullyQualifiedName!~UnitPolicyTests' /p:CollectCoverage=true '/p:ExcludeByFile=**/Runtime.fs%2c**/Program.fs' /p:Threshold=99 /p:ThresholdType=line /p:ThresholdStat=total /p:CoverletOutput=../../coverage/unit-core/",
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/badakmini/cli/behaviours/**/*"
      ],
      "options": {
        "cwd": "apps/badakmini-cli"
      },
      "outputs": [
        "{projectRoot}/coverage/unit-core",
        "{projectRoot}/tests/unit/bin",
        "{projectRoot}/tests/unit/obj"
      ]
    },
    "test:coverage:integration": {
      "command": "dotnet test tests/integration/Badakmini.Cli.IntegrationTests.fsproj --configuration Debug /p:CollectCoverage=true /p:Threshold=99 /p:ThresholdType=line /p:ThresholdStat=total /p:CoverletOutput=../../coverage/integration-application/",
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/badakmini/cli/behaviours/**/*"
      ],
      "options": {
        "cwd": "apps/badakmini-cli"
      },
      "outputs": [
        "{projectRoot}/coverage/integration-application",
        "{projectRoot}/tests/integration/bin",
        "{projectRoot}/tests/integration/obj"
      ]
    },
    "test:coverage:behaviour": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/badakmini/cli/behaviours/**/*",
        "{workspaceRoot}/apps/badakmini-cli-e2e/*.fs",
        "{workspaceRoot}/apps/badakmini-cli-e2e/*.fsproj",
        "{workspaceRoot}/apps/badakmini-cli-e2e/project.json"
      ],
      "options": {
        "commands": [
          {
            "command": "dotnet test tests/unit/Badakmini.Cli.UnitTests.fsproj --configuration Release --filter 'FullyQualifiedName~FeatureComplianceTests|FullyQualifiedName~UnitPolicyTests'",
            "forwardAllArgs": false
          },
          {
            "command": "dotnet test tests/integration/Badakmini.Cli.IntegrationTests.fsproj --configuration Release --filter 'FullyQualifiedName~FeatureComplianceTests|FullyQualifiedName~IntegrationPolicyTests'",
            "forwardAllArgs": false
          },
          {
            "command": "dotnet test ../badakmini-cli-e2e/Badakmini.Cli.E2eTests.fsproj --configuration Release --filter FullyQualifiedName~FeatureComplianceTests",
            "forwardAllArgs": false
          }
        ],
        "cwd": "apps/badakmini-cli",
        "forwardAllArgs": false,
        "parallel": false
      },
      "outputs": [
        "{projectRoot}/tests/unit/bin",
        "{projectRoot}/tests/unit/obj",
        "{projectRoot}/tests/integration/bin",
        "{projectRoot}/tests/integration/obj",
        "{workspaceRoot}/apps/badakmini-cli-e2e/bin",
        "{workspaceRoot}/apps/badakmini-cli-e2e/obj"
      ]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/badakmini/cli/behaviours/**/*",
        "{workspaceRoot}/apps/badakmini-cli-e2e/*.fs",
        "{workspaceRoot}/apps/badakmini-cli-e2e/*.fsproj",
        "{workspaceRoot}/apps/badakmini-cli-e2e/project.json"
      ],
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run -p badakmini-cli -t test:coverage:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run -p badakmini-cli -t test:coverage:integration",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run -p badakmini-cli -t test:coverage:behaviour",
            "forwardAllArgs": false
          }
        ],
        "forwardAllArgs": false,
        "parallel": false
      },
      "outputs": [
        "{projectRoot}/coverage",
        "{projectRoot}/tests/unit/bin",
        "{projectRoot}/tests/unit/obj",
        "{projectRoot}/tests/integration/bin",
        "{projectRoot}/tests/integration/obj"
      ]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/badakmini/cli/behaviours/**/*",
        "{workspaceRoot}/apps/badakmini-cli-e2e/*.fs",
        "{workspaceRoot}/apps/badakmini-cli-e2e/*.fsproj",
        "{workspaceRoot}/apps/badakmini-cli-e2e/project.json"
      ],
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run -p badakmini-cli -t typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run -p badakmini-cli -t lint",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run -p badakmini-cli -t test:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run -p badakmini-cli -t test:coverage:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run -p badakmini-cli -t test:coverage:behaviour",
            "forwardAllArgs": false
          }
        ],
        "forwardAllArgs": false,
        "parallel": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "fantomas . --check",
            "forwardAllArgs": false
          },
          {
            "command": "dotnet fsharplint lint Badakmini.Cli.fsproj",
            "forwardAllArgs": false
          },
          {
            "command": "dotnet fsharplint lint tests/unit/Badakmini.Cli.UnitTests.fsproj",
            "forwardAllArgs": false
          },
          {
            "command": "dotnet fsharplint lint tests/integration/Badakmini.Cli.IntegrationTests.fsproj",
            "forwardAllArgs": false
          }
        ],
        "cwd": "apps/badakmini-cli",
        "forwardAllArgs": false,
        "parallel": true
      }
    },
    "test:repo": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/**/*.md",
        "{workspaceRoot}/.agents/**/*",
        "{workspaceRoot}/.codex/**/*",
        "{workspaceRoot}/.claude/**/*",
        "{workspaceRoot}/.opencode/**/*",
        "{workspaceRoot}/.mcp.json",
        "{workspaceRoot}/CLAUDE.md",
        "{workspaceRoot}/opencode.json",
        "{workspaceRoot}/opencode.jsonc",
        "{workspaceRoot}/plans/**/*",
        "{workspaceRoot}/specs/**/*"
      ],
      "options": {
        "commands": [
          {
            "command": "dotnet bin/Release/net10.0/Badakmini.Cli.dll md links validate --root ../..",
            "forwardAllArgs": false
          },
          {
            "command": "dotnet bin/Release/net10.0/Badakmini.Cli.dll governance word-budget validate --root ../..",
            "forwardAllArgs": false
          },
          {
            "command": "dotnet bin/Release/net10.0/Badakmini.Cli.dll governance directory-map validate --root ../.. --directory repo-governance",
            "forwardAllArgs": false
          },
          {
            "command": "dotnet bin/Release/net10.0/Badakmini.Cli.dll governance directory-map validate --root ../.. --directory docs",
            "forwardAllArgs": false
          },
          {
            "command": "dotnet bin/Release/net10.0/Badakmini.Cli.dll governance directory-map validate --root ../.. --directory specs",
            "forwardAllArgs": false
          },
          {
            "command": "dotnet bin/Release/net10.0/Badakmini.Cli.dll governance directory-map validate --root ../.. --directory plans",
            "forwardAllArgs": false
          },
          {
            "command": "dotnet bin/Release/net10.0/Badakmini.Cli.dll governance harness-contract validate --root ../..",
            "forwardAllArgs": false
          },
          {
            "command": "dotnet bin/Release/net10.0/Badakmini.Cli.dll md mermaid validate --root ../..",
            "forwardAllArgs": false
          }
        ],
        "cwd": "apps/badakmini-cli",
        "forwardAllArgs": false,
        "parallel": true
      }
    }
  },
  "tags": []
}
