{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "badakmini-cli",
  "projectType": "application",
  "root": "apps/badakmini-cli",
  "targets": {
    "build": {
      "command": "dotnet build Badakmini.Cli.fsproj --configuration Release",
      "options": {
        "cwd": "apps/badakmini-cli"
      },
      "outputs": ["{projectRoot}/bin", "{projectRoot}/obj"]
    },
    "typecheck": {
      "command": "badakmini_typecheck_dir=$(mktemp -d /tmp/badakmini-typecheck.XXXXXX) && trap 'rm -rf -- \"$badakmini_typecheck_dir\"' EXIT HUP INT TERM && dotnet build tests/Badakmini.Cli.Tests.fsproj --configuration Release --artifacts-path \"$badakmini_typecheck_dir\"",
      "options": {
        "cwd": "apps/badakmini-cli"
      }
    },
    "test:unit": {
      "command": "dotnet test tests/Badakmini.Cli.Tests.fsproj --configuration Release",
      "options": {
        "cwd": "apps/badakmini-cli"
      },
      "outputs": ["{projectRoot}/tests/bin", "{projectRoot}/tests/obj"]
    },
    "test:coverage": {
      "command": "dotnet test tests/Badakmini.Cli.Tests.fsproj --configuration Debug /p:CollectCoverage=true /p:Threshold=99 /p:ThresholdType=line /p:ThresholdStat=total /p:CoverletOutput=../coverage/",
      "options": {
        "cwd": "apps/badakmini-cli"
      },
      "outputs": [
        "{projectRoot}/coverage",
        "{projectRoot}/tests/bin",
        "{projectRoot}/tests/obj"
      ]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run -p badakmini-cli -t typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run -p badakmini-cli -t lint",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run -p badakmini-cli -t test:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run -p badakmini-cli -t test:coverage",
            "forwardAllArgs": false
          }
        ],
        "forwardAllArgs": false,
        "parallel": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "fantomas . --check",
            "forwardAllArgs": false
          },
          {
            "command": "dotnet fsharplint lint Badakmini.Cli.fsproj",
            "forwardAllArgs": false
          },
          {
            "command": "dotnet fsharplint lint tests/Badakmini.Cli.Tests.fsproj",
            "forwardAllArgs": false
          }
        ],
        "cwd": "apps/badakmini-cli",
        "forwardAllArgs": false,
        "parallel": true
      }
    },
    "test:repo": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "dotnet bin/Release/net10.0/Badakmini.Cli.dll governance word-budget validate --root ../..",
            "forwardAllArgs": false
          },
          {
            "command": "dotnet bin/Release/net10.0/Badakmini.Cli.dll governance directory-map validate --root ../.. --directory repo-governance",
            "forwardAllArgs": false
          },
          {
            "command": "dotnet bin/Release/net10.0/Badakmini.Cli.dll governance directory-map validate --root ../.. --directory docs",
            "forwardAllArgs": false
          },
          {
            "command": "dotnet bin/Release/net10.0/Badakmini.Cli.dll md mermaid validate --root ../..",
            "forwardAllArgs": false
          }
        ],
        "cwd": "apps/badakmini-cli",
        "forwardAllArgs": false,
        "parallel": true
      }
    }
  },
  "tags": []
}
