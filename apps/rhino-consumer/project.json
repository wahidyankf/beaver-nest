{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "rhino-consumer",
  "projectType": "application",
  "root": "apps/rhino-consumer",
  "targets": {
    "test:repo": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/rhino",
        "{workspaceRoot}/rhino.lock",
        "{workspaceRoot}/repo-config.yml",
        "{workspaceRoot}/**/*.md",
        "{workspaceRoot}/.agents/**/*",
        "{workspaceRoot}/.codex/**/*",
        "{workspaceRoot}/.claude/**/*",
        "{workspaceRoot}/.opencode/**/*",
        "{workspaceRoot}/.mcp.json",
        "{workspaceRoot}/CLAUDE.md",
        "{workspaceRoot}/opencode.json",
        "{workspaceRoot}/opencode.jsonc",
        "{workspaceRoot}/plans/**/*",
        "{workspaceRoot}/specs/**/*",
        "{workspaceRoot}/scripts/public-safety/**/*"
      ],
      "options": {
        "commands": [
          {
            "command": "printf 'HEAD %s refs/heads/test-repo %s\\n' \"$(git rev-parse HEAD)\" 0000000000000000000000000000000000000000 | ./rhino gate run --surface pre-push --push-updates-stdin",
            "forwardAllArgs": false
          }
        ],
        "forwardAllArgs": false,
        "parallel": false
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/rhino",
        "{workspaceRoot}/rhino.lock",
        "{workspaceRoot}/.github/scripts/test-rhino-bootstrap.sh",
        "{workspaceRoot}/specs/apps/tools/rhino-consumer/**/*"
      ],
      "options": {
        "commands": [
          {
            "command": "./.github/scripts/test-rhino-bootstrap.sh",
            "forwardAllArgs": false
          }
        ],
        "forwardAllArgs": false,
        "parallel": false
      }
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "{workspaceRoot}/rhino",
        "{workspaceRoot}/rhino.lock",
        "{workspaceRoot}/.github/scripts/test-rhino-quick.sh",
        "{workspaceRoot}/specs/apps/tools/rhino-consumer/**/*"
      ],
      "options": {
        "commands": [
          {
            "command": "shellcheck rhino .github/scripts/test-rhino-quick.sh",
            "forwardAllArgs": false
          },
          {
            "command": "./.github/scripts/test-rhino-quick.sh",
            "forwardAllArgs": false
          },
          {
            "command": "./rhino behaviour coverage validate --rules B04,B05,B06,B07,B08",
            "forwardAllArgs": false
          }
        ],
        "forwardAllArgs": false,
        "parallel": false
      }
    },
    "test:behaviour:coverage": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "{workspaceRoot}/repo-config.yml",
        "{workspaceRoot}/rhino",
        "{workspaceRoot}/rhino.lock",
        "{workspaceRoot}/specs/**/*"
      ],
      "options": {
        "commands": [
          {
            "command": "./rhino behaviour coverage validate",
            "forwardAllArgs": false
          }
        ],
        "forwardAllArgs": false,
        "parallel": false
      }
    }
  },
  "tags": []
}
