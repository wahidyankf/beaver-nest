{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "rhino-consumer",
  "projectType": "application",
  "root": "apps/rhino-consumer",
  "targets": {
    "test:repo": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/rhino",
        "{workspaceRoot}/rhino.lock",
        "{workspaceRoot}/repo-config.yml",
        "{workspaceRoot}/**/*.md",
        "{workspaceRoot}/.agents/**/*",
        "{workspaceRoot}/.codex/**/*",
        "{workspaceRoot}/.claude/**/*",
        "{workspaceRoot}/.opencode/**/*",
        "{workspaceRoot}/.mcp.json",
        "{workspaceRoot}/CLAUDE.md",
        "{workspaceRoot}/opencode.json",
        "{workspaceRoot}/opencode.jsonc",
        "{workspaceRoot}/plans/**/*",
        "{workspaceRoot}/specs/**/*",
        "{workspaceRoot}/apps/rhino-consumer/repository-gate.sh"
      ],
      "options": {
        "commands": [
          {
            "command": "./rhino --bootstrap-exec apps/rhino-consumer/repository-gate.sh",
            "forwardAllArgs": false
          }
        ],
        "forwardAllArgs": false,
        "parallel": false
      }
    },
    "test:bootstrap": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/rhino",
        "{workspaceRoot}/rhino.lock",
        "{workspaceRoot}/.github/scripts/test-rhino-bootstrap.sh",
        "{workspaceRoot}/specs/tools/rhino-consumer/**/*"
      ],
      "options": {
        "commands": [
          {
            "command": "./.github/scripts/test-rhino-bootstrap.sh",
            "forwardAllArgs": false
          }
        ],
        "forwardAllArgs": false,
        "parallel": false
      }
    }
  },
  "tags": []
}
