{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "bnest-app",
  "projectType": "application",
  "root": "apps/bnest-app",
  "implicitDependencies": ["ex-bdd"],
  "targets": {
    "assets:build": {
      "command": "MIX_ENV=test mix assets.build",
      "options": {
        "cwd": "apps/bnest-app"
      },
      "cache": false
    },
    "serve": {
      "command": "BNEST_STABLE=${BNEST_STABLE:-true} PORT=${BNEST_DEV_PORT:-4020} ../../resource-guard run --class service --disk-path ../.. --lease-port ${BNEST_DEV_PORT:-4020} --lease-owner development --lease-min 4020 --lease-max 4029 -- mix phx.server",
      "options": {
        "cwd": "apps/bnest-app"
      },
      "continuous": true,
      "cache": false
    },
    "release:test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "node --test tools/release.test.mjs tools/continuity-contract.test.mjs tools/test-data-cleanup.test.mjs",
            "forwardAllArgs": false
          },
          {
            "command": "node --check tools/deployment.mjs",
            "forwardAllArgs": false
          },
          {
            "command": "node --check tools/verify-liveview.mjs",
            "forwardAllArgs": false
          }
        ],
        "cwd": "apps/bnest-app",
        "forwardAllArgs": false,
        "parallel": false
      },
      "cache": false
    },
    "release:run": {
      "command": "../../resource-guard run --class transactional --disk-path ../.. -- node tools/release.mjs",
      "options": {
        "cwd": "apps/bnest-app",
        "forwardAllArgs": true
      },
      "cache": false
    },
    "tailnet:up": {
      "command": "tailscale serve --bg --yes --https=443 --set-path=/ 4100",
      "cache": false
    },
    "tailnet:status": {
      "command": "tailscale serve status",
      "cache": false
    },
    "tailnet:down": {
      "command": "tailscale serve --https=443 --set-path=/ off",
      "cache": false
    },
    "proxy:install": {
      "command": "node tools/deployment.mjs proxy:install",
      "options": {
        "cwd": "apps/bnest-app",
        "forwardAllArgs": false
      },
      "cache": false
    },
    "proxy:status": {
      "command": "node tools/deployment.mjs proxy:status",
      "options": {
        "cwd": "apps/bnest-app",
        "forwardAllArgs": false
      },
      "cache": false
    },
    "release:build": {
      "command": "node tools/deployment.mjs release:build",
      "options": {
        "cwd": "apps/bnest-app",
        "forwardAllArgs": false
      },
      "cache": false
    },
    "deploy:prepare": {
      "command": "node tools/deployment.mjs deploy:prepare",
      "options": {
        "cwd": "apps/bnest-app",
        "forwardAllArgs": true
      },
      "cache": false
    },
    "deploy:promote": {
      "command": "node tools/deployment.mjs deploy:promote",
      "options": {
        "cwd": "apps/bnest-app",
        "forwardAllArgs": true
      },
      "cache": false
    },
    "deploy:rollback": {
      "command": "node tools/deployment.mjs deploy:rollback",
      "options": {
        "cwd": "apps/bnest-app",
        "forwardAllArgs": false
      },
      "cache": false
    },
    "deploy:retire": {
      "command": "node tools/deployment.mjs deploy:retire",
      "options": {
        "cwd": "apps/bnest-app",
        "forwardAllArgs": true
      },
      "cache": false
    },
    "schema:audit": {
      "command": "BNEST_STABLE=true MIX_ENV=dev mix bnest.schema.audit",
      "options": {
        "cwd": "apps/bnest-app"
      },
      "cache": false
    },
    "identity:benchmark": {
      "command": "BNEST_STABLE=true MIX_ENV=dev mix bnest.identity.benchmark",
      "options": {
        "cwd": "apps/bnest-app"
      },
      "cache": false
    },
    "storage:migrate": {
      "command": "BNEST_STABLE=true MIX_ENV=dev mix bnest.storage.migrate",
      "options": {
        "cwd": "apps/bnest-app",
        "forwardAllArgs": true
      },
      "cache": false
    },
    "storage:relocate": {
      "command": "BNEST_STABLE=true MIX_ENV=dev mix bnest.storage.relocate",
      "options": {
        "cwd": "apps/bnest-app",
        "forwardAllArgs": true
      },
      "cache": false
    },
    "storage:retire": {
      "command": "BNEST_STABLE=true MIX_ENV=dev mix bnest.storage.retire",
      "options": {
        "cwd": "apps/bnest-app",
        "forwardAllArgs": true
      },
      "cache": false
    },
    "storage:purge-test-data": {
      "command": "BNEST_STABLE=true MIX_ENV=dev mix bnest.storage.purge_test_data",
      "options": {
        "cwd": "apps/bnest-app",
        "forwardAllArgs": true
      },
      "cache": false
    },
    "test-data:cleanup": {
      "command": "node tools/test-data-cleanup.mjs",
      "options": {
        "cwd": "apps/bnest-app",
        "forwardAllArgs": true
      },
      "cache": false
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "MIX_ENV=test mix compile --warnings-as-errors --force",
            "forwardAllArgs": false
          },
          {
            "command": "MIX_ENV=test mix dialyzer --no-compile --format short",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- tsc --project assets/tsconfig.json --noEmit",
            "forwardAllArgs": false
          }
        ],
        "cwd": "apps/bnest-app",
        "forwardAllArgs": false,
        "parallel": false
      },
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "mix format --check-formatted",
            "forwardAllArgs": false
          },
          {
            "command": "mix credo --strict",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- oxlint --deny correctness --deny suspicious --deny pedantic --deny perf --deny-warnings --report-unused-disable-directives assets/js",
            "forwardAllArgs": false
          },
          {
            "command": "mix deps.unlock --check-unused",
            "forwardAllArgs": false
          }
        ],
        "cwd": "apps/bnest-app",
        "forwardAllArgs": false,
        "parallel": false
      }
    },
    "test:unit": {
      "command": "BNEST_TEST_LAYER=unit MIX_ENV=test mix do compile --warnings-as-errors + test --warnings-as-errors --no-start test/unit",
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/bnest/app/behaviours/**/*.feature"
      ],
      "options": {
        "cwd": "apps/bnest-app"
      }
    },
    "test:integration": {
      "dependsOn": ["test-data:cleanup"],
      "command": "BNEST_TEST_LAYER=integration MIX_ENV=test mix do compile --warnings-as-errors + test --warnings-as-errors --exclude integration-exempt --max-cases 1 test/integration",
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/bnest/app/behaviours/**/*.feature"
      ],
      "options": {
        "cwd": "apps/bnest-app"
      }
    },
    "test:coverage:unit": {
      "command": "BNEST_TEST_LAYER=unit MIX_ENV=test mix do compile --warnings-as-errors + test --warnings-as-errors --no-start --cover test/unit",
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/bnest/app/behaviours/**/*.feature"
      ],
      "options": {
        "cwd": "apps/bnest-app"
      },
      "outputs": ["{projectRoot}/cover/unit"]
    },
    "test:coverage:integration": {
      "dependsOn": ["test-data:cleanup"],
      "command": "BNEST_TEST_LAYER=integration MIX_ENV=test mix do compile --warnings-as-errors + test --warnings-as-errors --exclude integration-exempt --cover --max-cases 1 test/integration",
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/bnest/app/behaviours/**/*.feature"
      ],
      "options": {
        "cwd": "apps/bnest-app"
      },
      "outputs": ["{projectRoot}/cover/integration"]
    },
    "test:coverage:behaviour:app": {
      "command": "MIX_ENV=test mix run --no-start test/behaviour/verify.exs",
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/bnest/app/behaviours/**/*.feature"
      ],
      "options": {
        "cwd": "apps/bnest-app"
      }
    },
    "test:coverage:behaviour": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/bnest/app/behaviours/**/*.feature"
      ],
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run -p bnest-app -t test:coverage:behaviour:app",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run -p bnest-app-e2e -t test:coverage:behaviour:e2e",
            "forwardAllArgs": false
          }
        ],
        "forwardAllArgs": false,
        "parallel": false
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/bnest/app/behaviours/**/*.feature"
      ],
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run -p bnest-app -t test:coverage:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run -p bnest-app -t test:coverage:integration",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run -p bnest-app -t test:coverage:behaviour",
            "forwardAllArgs": false
          }
        ],
        "forwardAllArgs": false,
        "parallel": false
      }
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/bnest/app/behaviours/**/*.feature"
      ],
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run -p bnest-app -t typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run -p bnest-app -t lint",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run -p bnest-app -t test:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run -p bnest-app -t test:coverage:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run -p bnest-app -t test:coverage:behaviour",
            "forwardAllArgs": false
          }
        ],
        "forwardAllArgs": false,
        "parallel": false
      },
      "cache": false
    },
    "format": {
      "command": "mix format --check-formatted",
      "options": {
        "cwd": "apps/bnest-app"
      }
    }
  },
  "tags": []
}
