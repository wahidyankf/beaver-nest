<Layouts.flash_group flash={@flash} />
<main class="home-shell">
  <div class="home-grid" aria-hidden="true"></div>
  <div class="home-sun home-sun-one" aria-hidden="true"></div>
  <div class="home-sun home-sun-two" aria-hidden="true"></div>

  <header class="home-header">
    <a href="/" class="home-brand" aria-label="Beaver Nest home">
      <img
        class="home-brand-logo"
        data-role="brand-logo"
        src="/images/beaver-nest-logo.png"
        alt="Beaver Nest logo"
        width="56"
        height="56"
      />
      <span>Beaver Nest</span>
    </a>
    <div class="home-account">
      <p class="home-status">
        <span aria-hidden="true">●</span> {@current_user["displayUsername"]}
      </p>
      <div class="home-account-actions">
        <nav class="home-theme-control" aria-label="Color theme">
          <Layouts.theme_toggle />
        </nav>
        <%= unless @current_user["migrationMode"] do %>
          <form action="/logout" method="post">
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <input type="hidden" name="_method" value="delete" />
            <button class="home-logout" type="submit">Log out</button>
          </form>
        <% end %>
      </div>
    </div>
  </header>

  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-copy">
      <p class="home-kicker">A SMALL PLACE FOR BIG QUESTIONS</p>
      <h1 id="home-title">Beaver Nest</h1>
      <p class="home-lede">
        Bring a thought, a riddle, or a wild idea. We will follow it together.
      </p>
    </div>

    <a href="/chat" class="chat-entry" data-role="chat-entry">
      <span class="chat-entry-mark" aria-hidden="true">
        <span>✦</span>
      </span>
      <span class="chat-entry-copy">
        <strong>Start chatting</strong>
        <small>Ask, make, and explore</small>
      </span>
      <span class="chat-entry-arrow" aria-hidden="true">→</span>
    </a>

    <a href="/apps/sifat-allah" class="chat-entry sifat-entry" data-role="sifat-allah-entry">
      <span class="chat-entry-mark" aria-hidden="true">
        <span>◎</span>
      </span>
      <span class="chat-entry-copy">
        <strong>Misi hafal 40 sifat Allah</strong>
        <small>Belajar sedikit, ulangi yang sulit</small>
      </span>
      <span class="chat-entry-arrow" aria-hidden="true">→</span>
    </a>

    <p :if={@current_user["migrationMode"]} class="home-note">
      Your existing chat and learning progress remain in this browser during migration.
    </p>
    <p :if={!@current_user["migrationMode"]} class="home-note">
      Your chat and learning progress are saved to your account.
    </p>
  </section>
</main>
