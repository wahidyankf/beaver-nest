{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "bnest-e2e",
  "projectType": "application",
  "root": "apps/bnest-e2e",
  "implicitDependencies": ["bnest-app"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- tsc --project apps/bnest-e2e/tsconfig.json --noEmit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- oxlint --deny typescript/no-explicit-any --deny-warnings apps/bnest-e2e",
            "forwardAllArgs": false
          }
        ],
        "forwardAllArgs": false,
        "parallel": false
      }
    },
    "lint": {
      "command": "npm exec -- oxlint --deny correctness --deny suspicious --deny pedantic --deny perf --deny typescript/no-explicit-any --deny-warnings --report-unused-disable-directives apps/bnest-e2e"
    },
    "test:behaviour:compliance": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/specs/bnest/e2e/behaviours/**/*.feature",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/package-lock.json"
      ],
      "outputs": ["{projectRoot}/.features-gen"],
      "options": {
        "commands": [
          {
            "command": "node --test apps/bnest-e2e/tools/behaviour-compliance.test.mts",
            "forwardAllArgs": false
          },
          {
            "command": "node apps/bnest-e2e/tools/check-behaviour-compliance.mts",
            "forwardAllArgs": false
          }
        ],
        "forwardAllArgs": false,
        "parallel": false
      }
    },
    "test:e2e": {
      "command": "npm exec -- playwright test --config apps/bnest-e2e/playwright.config.mts",
      "dependsOn": ["test:behaviour:compliance"],
      "cache": false
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run -p bnest-e2e -t typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run -p bnest-e2e -t lint",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run -p bnest-e2e -t test:behaviour:compliance",
            "forwardAllArgs": false
          }
        ],
        "forwardAllArgs": false,
        "parallel": false
      },
      "cache": false
    }
  },
  "tags": []
}
