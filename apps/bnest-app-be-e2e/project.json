{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "bnest-app-be-e2e",
  "projectType": "application",
  "root": "apps/bnest-app-be-e2e",
  "implicitDependencies": ["bnest-app"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- tsc --project apps/bnest-app-be-e2e/tsconfig.json --noEmit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- oxlint --deny typescript/no-explicit-any --deny-warnings apps/bnest-app-be-e2e",
            "forwardAllArgs": false
          }
        ],
        "forwardAllArgs": false,
        "parallel": false
      }
    },
    "lint": {
      "command": "npm exec -- oxlint --deny correctness --deny suspicious --deny pedantic --deny perf --deny typescript/no-explicit-any --deny-warnings --report-unused-disable-directives apps/bnest-app-be-e2e"
    },
    "test:coverage:behaviour": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/specs/apps/bnest/app-be/behaviours/**/*.feature",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/package-lock.json"
      ],
      "outputs": ["{projectRoot}/.features-gen"],
      "options": {
        "commands": [
          {
            "command": "node --test apps/bnest-app-be-e2e/tools/behaviour-compliance.test.mts",
            "forwardAllArgs": false
          },
          {
            "command": "node apps/bnest-app-be-e2e/tools/check-behaviour-compliance.mts",
            "forwardAllArgs": false
          }
        ],
        "forwardAllArgs": false,
        "parallel": false
      }
    },
    "test:e2e": {
      "command": "BNEST_BE_E2E_PORT=${BNEST_BE_E2E_PORT:-4030} ./hippo run --class ephemeral --resource-tier standard --disk-path . --lease-port ${BNEST_BE_E2E_PORT:-4030} --lease-owner be-e2e --lease-min 4030 --lease-max 4039 -- node apps/bnest-app-be-e2e/tools/run-e2e.mts",
      "dependsOn": [
        "test:coverage:behaviour",
        {
          "projects": ["bnest-app"],
          "target": "assets:build"
        }
      ],
      "cache": false
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run -p bnest-app-be-e2e -t typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run -p bnest-app-be-e2e -t lint",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run -p bnest-app-be-e2e -t test:coverage:behaviour",
            "forwardAllArgs": false
          }
        ],
        "forwardAllArgs": false,
        "parallel": false
      },
      "cache": false
    },
    "test:release-quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run -p bnest-app-be-e2e -t typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run -p bnest-app-be-e2e -t lint",
            "forwardAllArgs": false
          }
        ],
        "forwardAllArgs": false,
        "parallel": false
      },
      "cache": false
    }
  },
  "tags": []
}
