#!/bin/sh
set -eu

tool_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
lock_file="$tool_dir/hippo.lock"

# Every lock key must resolve exactly once. Ambiguous pins fail as invalid
# configuration before any network or cache operation occurs.
lock_value() {
	key=$1
	value=$(awk -F= -v key="$key" '$1 == key { print substr($0, index($0, "=") + 1) }' "$lock_file")
	case "$value" in
	'' | *'
'*)
		echo "hippo lock has missing or duplicate $key" >&2
		exit 78
		;;
	esac
	printf '%s\n' "$value"
}

# Pin both release identity and source commit so a correctly checksummed asset
# still cannot impersonate a different build.
version=$(lock_value version)
commit=$(lock_value commit)
case "$version" in
v[0-9]*.[0-9]*.[0-9]*) ;;
*)
	echo "hippo lock has an invalid version" >&2
	exit 78
	;;
esac
case "$commit" in
*[!0-9a-f]* | '')
	echo "hippo lock has an invalid commit" >&2
	exit 78
	;;
esac
if [ "${#commit}" -ne 40 ]; then
	echo "hippo lock has an invalid commit" >&2
	exit 78
fi

# Normalize only the platform matrix published by the upstream release job.
case "$(uname -s)" in
Darwin) goos=darwin ;;
Linux) goos=linux ;;
*)
	echo "hippo does not support this operating system" >&2
	exit 78
	;;
esac
case "$(uname -m)" in
x86_64 | amd64) goarch=amd64 ;;
arm64 | aarch64) goarch=arm64 ;;
*)
	echo "hippo does not support this architecture" >&2
	exit 78
	;;
esac

checksum=$(lock_value "$goos-$goarch")
case "$checksum" in
*[!0-9a-f]* | '')
	echo "hippo lock has an invalid checksum" >&2
	exit 78
	;;
esac
if [ "${#checksum}" -ne 64 ]; then
	echo "hippo lock has an invalid checksum" >&2
	exit 78
fi

# Keep downloaded binaries outside the repository by default. Tests may point
# at an isolated cache without weakening checksum verification.
if [ -n "${HIPPO_INSTALL_CACHE:-}" ]; then
	cache_root=$HIPPO_INSTALL_CACHE
elif [ "$goos" = darwin ]; then
	cache_root=${XDG_CACHE_HOME:-"$HOME/Library/Caches"}/hippo
else
	cache_root=${XDG_CACHE_HOME:-"$HOME/.cache"}/hippo
fi

binary_dir="$cache_root/$version/$goos-$goarch"
binary="$binary_dir/hippo"
install_lock="$binary_dir.lock"

hash_file() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$1" | awk '{print $1}'
	else
		shasum -a 256 "$1" | awk '{print $1}'
	fi
}

acquire_install_lock() {
	attempts=0
	# mkdir is an atomic, portable lock. Only a lock whose numeric PID no longer
	# exists may be reclaimed; live or malformed ownership is never overwritten.
	while ! mkdir "$install_lock" 2>/dev/null; do
		if [ -f "$install_lock/pid" ]; then
			lock_pid=$(sed -n '1p' "$install_lock/pid" 2>/dev/null || true)
			case "$lock_pid" in
			'' | *[!0-9]*) ;;
			*)
				if ! kill -0 "$lock_pid" 2>/dev/null; then
					rm -f -- "$install_lock/pid"
					rmdir "$install_lock" 2>/dev/null || true
					continue
				fi
				;;
			esac
		fi
		attempts=$((attempts + 1))
		if [ "$attempts" -ge 300 ]; then
			echo "hippo bootstrap timed out waiting for its install lock" >&2
			exit 75
		fi
		sleep 1
	done
	printf '%s\n' "$$" >"$install_lock/pid"
}

prune_cache() {
	inventory=$(mktemp "$cache_root/.retention.XXXXXX")
	trap 'rm -f -- "$inventory"' EXIT HUP INT TERM
	for candidate_path in "$cache_root"/v*; do
		[ -d "$candidate_path" ] || continue
		candidate=${candidate_path##*/}
		case "$candidate" in
		v[0-9]*.[0-9]*.[0-9]*) ;;
		*) continue ;;
		esac
		modified=$(stat -f '%m' "$candidate_path" 2>/dev/null || stat -c '%Y' "$candidate_path")
		printf '%s %s\n' "$modified" "$candidate" >>"$inventory"
	done
	# Retain the pinned release plus two recent fallbacks. Candidate directory
	# names are validated as versions before recursive removal is possible.
	recent=0
	LC_ALL=C sort -rn "$inventory" | while IFS=' ' read -r _ candidate; do
		[ -n "$candidate" ] || continue
		if [ "$candidate" = "$version" ]; then
			continue
		fi
		recent=$((recent + 1))
		if [ "$recent" -gt 2 ]; then
			rm -rf -- "${cache_root:?}/$candidate"
		fi
	done
	rm -f -- "$inventory"
	trap - EXIT HUP INT TERM
}

if [ ! -x "$binary" ]; then
	mkdir -p "$cache_root/$version"
	acquire_install_lock
	trap 'rm -f -- "$install_lock/pid"; rmdir "$install_lock" 2>/dev/null || true' EXIT HUP INT TERM
	if [ ! -x "$binary" ]; then
		# Download into the same cache filesystem, verify the pinned archive and
		# embedded identity, then publish the executable with two atomic renames.
		temporary_dir=$(mktemp -d "$cache_root/.install.XXXXXX")
		trap 'rm -rf -- "$temporary_dir"; rm -f -- "$install_lock/pid"; rmdir "$install_lock" 2>/dev/null || true' EXIT HUP INT TERM
		asset="hippo_${version}_${goos}_${goarch}.tar.gz"
		base_url=${HIPPO_DOWNLOAD_BASE_URL:-"https://github.com/wahidyankf/hippo/releases/download/$version"}
		archive="$temporary_dir/$asset"
		curl --fail --location --silent --show-error --retry 3 --output "$archive" "$base_url/$asset"
		if [ "$(hash_file "$archive")" != "$checksum" ]; then
			echo "hippo release checksum mismatch" >&2
			exit 78
		fi
		if [ "$(tar -tzf "$archive")" != hippo ]; then
			echo "hippo release archive has an invalid inventory" >&2
			exit 78
		fi
		tar -xzf "$archive" -C "$temporary_dir" hippo
		chmod 700 "$temporary_dir/hippo"
		identity=$("$temporary_dir/hippo" version --json)
		case "$identity" in
		*"\"version\":\"$version\""*"\"commit\":\"$commit\""*) ;;
		*)
			echo "hippo release identity does not match its lock" >&2
			exit 78
			;;
		esac
		mkdir -p "$binary_dir"
		mv "$temporary_dir/hippo" "$binary.tmp.$$"
		mv "$binary.tmp.$$" "$binary"
		rm -rf -- "$temporary_dir"
	fi
	rm -f -- "$install_lock/pid"
	rmdir "$install_lock"
	trap - EXIT HUP INT TERM
	prune_cache
fi

# Explicit caller configuration wins; otherwise the ignored repository-local
# policy is optional and remains consumer-owned.
HIPPO_DEFAULT_CONFIG=${HIPPO_DEFAULT_CONFIG:-"$tool_dir/hippo.local.json"}
export HIPPO_DEFAULT_CONFIG

# The upstream binary stays ecosystem-neutral. This consumer wrapper maps its
# resolved concurrency into the worker controls used by Beaver Nest's tools.
case "${1:-}" in
run)
	shift
	exec "$binary" run \
		--concurrency-env NX_PARALLEL \
		--concurrency-env GOMAXPROCS \
		--concurrency-env DOTNET_PROCESSOR_COUNT \
		"$@"
	;;
*)
	exec "$binary" "$@"
	;;
esac
