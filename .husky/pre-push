set -e

zero_oid=0000000000000000000000000000000000000000
run_markdown_check=

markdown_changes_for_range() {
  if [ "$2" = "$zero_oid" ]; then
    git log --format= --name-only "$1" --not --remotes -- \
      ':(icase,glob)**/*.md'
  else
    git diff --name-only "$2" "$1" -- \
      ':(icase,glob)**/*.md'
    git log --format= --name-only "$2..$1" -- \
      ':(icase,glob)**/*.md'
  fi
}

while read -r _local_ref local_oid _remote_ref remote_oid; do
  if [ "$local_oid" = "$zero_oid" ]; then
    continue
  fi

  if [ -z "$run_markdown_check" ] &&
    [ -n "$(markdown_changes_for_range "$local_oid" "$remote_oid")" ]; then
    run_markdown_check=1
  fi
done

if [ -z "$run_markdown_check" ]; then
  echo "Skipping repository governance validation: no Markdown changes are being pushed."
  exit 0
fi

NX_NO_CLOUD=true npm exec -- nx run badakmini-cli:check
