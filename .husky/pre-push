set -e

# Git supplies the ref updates on stdin, and two consumers want them: the
# declared `pre-push` surface, whose safety gate screens the refs and the commit
# messages about to be published, and the loop below, which decides which
# projects are affected. A pipe can only be drained once, so it is read once
# here and each consumer is fed from that. Whichever ran first would otherwise
# leave the second reading an empty stream and reporting a clean pass over
# nothing.
ref_updates=$(cat)

zero_oid=0000000000000000000000000000000000000000
run_repository_check=
# Each consumer boundary has its own suite, tracked separately so an ordinary
# push pays nothing for either.
run_hippo_consumer_check=
run_rhino_consumer_check=

# Each pushed commit range receives the same HIPPO-guarded affected quick
# graph; Nx uses the admitted allocation. Deleted refs schedule no work.
quick_checks_for_head() {
	NX_NO_CLOUD=true ./hippo run --class ephemeral --disk-path . -- \
		npm exec -- nx affected -t test:quick \
		--base=origin/main --head="$1"
}

validation_changes_for_range() {
	# New branches compare all local-only commits; existing branches include
	# both working-tree range names and committed history for reliable routing.
	if [ "$2" = "$zero_oid" ]; then
		git log --format= --name-only "$1" --not --remotes -- \
			':(icase,glob)**/*.md' \
			':(glob)repo-governance/**' ':(glob)docs/**' ':(glob)specs/**' ':(glob)plans/**' \
			'repo-config.yml' ':(glob)apps/rhino-consumer/**' '.husky/pre-push' \
			':(glob)scripts/public-safety/**' \
			':(glob).agents/**' ':(glob).codex/**' ':(glob).claude/**' ':(glob).opencode/**' \
			'.mcp.json' 'CLAUDE.md' 'opencode.json' 'opencode.jsonc'
	else
		git diff --name-only "$2" "$1" -- \
			':(icase,glob)**/*.md' \
			':(glob)repo-governance/**' ':(glob)docs/**' ':(glob)specs/**' ':(glob)plans/**' \
			'repo-config.yml' ':(glob)apps/rhino-consumer/**' '.husky/pre-push' \
			':(glob)scripts/public-safety/**' \
			':(glob).agents/**' ':(glob).codex/**' ':(glob).claude/**' ':(glob).opencode/**' \
			'.mcp.json' 'CLAUDE.md' 'opencode.json' 'opencode.jsonc'
		git log --format= --name-only "$2..$1" -- \
			':(icase,glob)**/*.md' \
			':(glob)repo-governance/**' ':(glob)docs/**' ':(glob)specs/**' ':(glob)plans/**' \
			'repo-config.yml' ':(glob)apps/rhino-consumer/**' '.husky/pre-push' \
			':(glob)scripts/public-safety/**' \
			':(glob).agents/**' ':(glob).codex/**' ':(glob).claude/**' ':(glob).opencode/**' \
			'.mcp.json' 'CLAUDE.md' 'opencode.json' 'opencode.jsonc'
	fi
}

# A consumer boundary is narrower than the governed-content set above: only the
# pinned bootstrap, its lock, its policy example, and its own suite.
hippo_consumer_changes_for_range() {
	if [ "$2" = "$zero_oid" ]; then
		git log --format= --name-only "$1" --not --remotes -- \
			hippo hippo.lock hippo.local.json.example \
			'.github/scripts/test-hippo-bootstrap.sh' \
			':(glob)specs/tools/hippo-consumer/**'
	else
		git diff --name-only "$2" "$1" -- \
			hippo hippo.lock hippo.local.json.example \
			'.github/scripts/test-hippo-bootstrap.sh' \
			':(glob)specs/tools/hippo-consumer/**'
		git log --format= --name-only "$2..$1" -- \
			hippo hippo.lock hippo.local.json.example \
			'.github/scripts/test-hippo-bootstrap.sh' \
			':(glob)specs/tools/hippo-consumer/**'
	fi
}

rhino_consumer_changes_for_range() {
	if [ "$2" = "$zero_oid" ]; then
		git log --format= --name-only "$1" --not --remotes -- \
			rhino rhino.lock \
			'.github/scripts/test-rhino-bootstrap.sh' \
			':(glob)specs/tools/rhino-consumer/**'
	else
		git diff --name-only "$2" "$1" -- \
			rhino rhino.lock \
			'.github/scripts/test-rhino-bootstrap.sh' \
			':(glob)specs/tools/rhino-consumer/**'
		git log --format= --name-only "$2..$1" -- \
			rhino rhino.lock \
			'.github/scripts/test-rhino-bootstrap.sh' \
			':(glob)specs/tools/rhino-consumer/**'
	fi
}

# Screen before anything else on this surface. A gate that decides what may
# leave the repository is worth nothing if a cheaper check ahead of it can spend
# the push's time first, and worth less still if that check passes the change
# through while the screen is still queued.
#
# Git's own arguments are deliberately not forwarded: arguments after `--` reach
# every gate on the surface, and nothing declared here takes a remote name or a
# URL. What the safety gate reads is the ref-update lines, which arrive on stdin
# either way -- and the guard passes stdin through, so the admission boundary
# the repository checks already run behind costs nothing here.
printf '%s\n' "$ref_updates" | ./hippo run --class ephemeral --disk-path . -- \
	./rhino gate run --surface pre-push

# The heredoc keeps the loop in this shell, so the three decisions it records
# survive it.
while read -r _local_ref local_oid _remote_ref remote_oid; do
	if [ -z "$_local_ref" ]; then
		# The capture ends in a newline, so the last read yields a blank line.
		continue
	fi

	if [ "$local_oid" = "$zero_oid" ]; then
		continue
	fi

	quick_checks_for_head "$local_oid"

	if [ -z "$run_repository_check" ] &&
		[ -n "$(validation_changes_for_range "$local_oid" "$remote_oid")" ]; then
		run_repository_check=1
	fi

	if [ -z "$run_hippo_consumer_check" ] &&
		[ -n "$(hippo_consumer_changes_for_range "$local_oid" "$remote_oid")" ]; then
		run_hippo_consumer_check=1
	fi

	if [ -z "$run_rhino_consumer_check" ] &&
		[ -n "$(rhino_consumer_changes_for_range "$local_oid" "$remote_oid")" ]; then
		run_rhino_consumer_check=1
	fi
done <<REFS
$ref_updates
REFS

# The bootstrap suite is the only surface that inspects the pinned consumer
# itself. It runs on this workstation, so it cannot observe Linux-only
# behaviour; what it does catch is a timestamp read that skips the platform
# branch and a scenario corpus that no longer matches its implementations. Both
# of those reached main once because nothing ran this before a push.
if [ -n "$run_hippo_consumer_check" ]; then
	NX_NO_CLOUD=true ./hippo run --class ephemeral --disk-path . -- \
		./.github/scripts/test-hippo-bootstrap.sh
fi

# The same contract for RHINO, plus a lint pass: `rhino` is this repository's
# own fork of the bootstrap rather than a vendored upstream file, so no other
# gate reads it.
if [ -n "$run_rhino_consumer_check" ]; then
	NX_NO_CLOUD=true ./hippo run --class ephemeral --disk-path . -- \
		sh -c 'shellcheck rhino .github/scripts/test-rhino-bootstrap.sh &&
			./.github/scripts/test-rhino-bootstrap.sh'
fi

# The heavier repository documentation contract runs once per push, only when
# governed content or its enforcement changed in any pushed range.
if [ -z "$run_repository_check" ]; then
	echo "Skipping repository validation: pushed commits do not affect governed content or its validators."
	exit 0
fi

NX_NO_CLOUD=true ./hippo run --class ephemeral --disk-path . -- \
	npm exec -- nx run -p rhino-consumer -t test:repo
