set -e

zero_oid=0000000000000000000000000000000000000000
run_repository_check=

quick_checks_for_head() {
  NX_NO_CLOUD=true npm exec -- nx affected -t test:quick \
    --base=origin/main --head="$1"
}

validation_changes_for_range() {
  if [ "$2" = "$zero_oid" ]; then
    git log --format= --name-only "$1" --not --remotes -- \
      ':(icase,glob)**/*.md' \
      ':(glob)repo-governance/**' ':(glob)docs/**' ':(glob)specs/**' ':(glob)plans/**'
  else
    git diff --name-only "$2" "$1" -- \
      ':(icase,glob)**/*.md' \
      ':(glob)repo-governance/**' ':(glob)docs/**' ':(glob)specs/**' ':(glob)plans/**'
    git log --format= --name-only "$2..$1" -- \
      ':(icase,glob)**/*.md' \
      ':(glob)repo-governance/**' ':(glob)docs/**' ':(glob)specs/**' ':(glob)plans/**'
  fi
}

while read -r _local_ref local_oid _remote_ref remote_oid; do
  if [ "$local_oid" = "$zero_oid" ]; then
    continue
  fi

  quick_checks_for_head "$local_oid"

  if [ -z "$run_repository_check" ] &&
    [ -n "$(validation_changes_for_range "$local_oid" "$remote_oid")" ]; then
    run_repository_check=1
  fi
done

if [ -z "$run_repository_check" ]; then
  echo "Skipping repository validation: no Markdown or mapped-tree changes are being pushed."
  exit 0
fi

NX_NO_CLOUD=true npm exec -- nx run -p badakmini-cli -t test:repo
