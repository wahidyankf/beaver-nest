set -e

# Git supplies the ref updates on stdin, and this surface reads them once: the
# leak scan is the only work here (C6). It screens every commit a push would
# publish, its messages, names, and additions, before anything leaves this
# machine. Tests, lint, and document checks run at the pull-request surface, so a
# push never waits on them, and the affected-project graph no longer runs here
# (BN-2).
#
# Git's own arguments are deliberately not forwarded: nothing declared on this
# surface takes a remote name or a URL. `--push-updates-stdin` is what lets RHINO
# read the ref updates; without it a push-update range is refused, not guessed.
# HIPPO bounds the RHINO call, and it passes stdin through.
ref_updates=$(cat)
printf '%s\n' "$ref_updates" | ./hippo run --class ephemeral --resource-tier standard --disk-path . -- ./rhino gate run --surface pre-push --push-updates-stdin
