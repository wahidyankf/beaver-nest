# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Runtime data is private and must never be committed. Keep only the directory
# placeholders so the expected layout is available after cloning.
/data/*
!/data/system/
/data/system/*
!/data/system/.gitkeep
!/data/user/
/data/user/*
!/data/user/.gitkeep
