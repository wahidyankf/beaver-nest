# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Runtime data is private and must never be committed. Keep only the directory
# placeholders so the expected layout is available after cloning.
/data/*
!/data/general/
/data/general/*
!/data/general/.gitkeep
!/data/system/
/data/system/*
!/data/system/.gitkeep
!/data/users/
/data/users/*
!/data/users/.gitkeep
!/data/prod/
/data/prod/*
!/data/prod/general/
/data/prod/general/*
!/data/prod/general/.gitkeep
!/data/prod/apps/
/data/prod/apps/*
!/data/prod/apps/beaver-nest/
/data/prod/apps/beaver-nest/*
!/data/prod/apps/beaver-nest/.gitkeep
!/data/prod/system/
/data/prod/system/*
!/data/prod/system/.gitkeep
!/data/prod/users/
/data/prod/users/*
!/data/prod/users/.gitkeep
!/data/test/
/data/test/*
!/data/test/runs/
/data/test/runs/*
!/data/test/runs/.gitkeep

# Bnest's storage pointer remains configuration at ~/.config/bnest. SQLite data
# defaults to ~/bnest/data/{prod,test/runs} (or an admin-selected directory)
# and is never expected inside the tree. These patterns are a defensive
# backstop only, in case local testing ever misconfigures its storage path.
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal



.nx/cache
.nx/workspace-data
.nx/migrate-runs
.nx/polygraph
.claude/worktrees
.claude/settings.local.json
CLAUDE.local.md
.memsearch/

# Local Git worktrees. Keep only the directory placeholder in version control.
/worktrees/*
!/worktrees/.gitkeep
